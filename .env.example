# Deployment-oriented reference. The authoritative per-app examples are
# backend/.env.example and frontend/.env.example. Never commit real values.
# Copy to .env only for local development; .env is git-ignored.

# ---- Backend (Render) ----
# MongoDB Atlas connection string. Optional: if empty/unreachable the API
# runs with in-memory prediction history and /health reports
# database="disabled"/"degraded".
MONGO_URI=
MONGO_DB=fraud_detection
MONGO_COLLECTION=predictions

# CORS: comma-separated allowed origins. Set to your Vercel frontend URL in
# production (e.g. https://your-app.vercel.app). Empty = deny-by-default.
CORS_ORIGINS=http://localhost:5173

# Model identity (informational; served on /model-info)
MODEL_VERSION=1.0.0
RISK_CONFIG_VERSION=1.0.0
# PREDICT_THRESHOLD=   # leave unset: uses validated threshold 0.55

# Request size limits (bytes)
MAX_JSON_BYTES=1000000
MAX_CSV_BYTES=5000000
MAX_BATCH_ROWS=2000

# Python version for Render (also set as PYTHON_VERSION env var there)
PYTHON_VERSION=3.12.4

# ---- Frontend (Vercel) ----
# Public base URL of the deployed Render backend. Set this in the Vercel
# project environment variables, not in source code.
VITE_API_URL=http://127.0.0.1:8123
