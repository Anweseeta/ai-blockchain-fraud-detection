# Copy to .env and fill in. Never commit .env.
# MongoDB is optional: if MONGO_URI is empty/unreachable the API runs with
# in-memory prediction history and reports database="disabled"/"degraded" on /health.
MONGO_URI=
MONGO_DB=fraud_detection
MONGO_COLLECTION=predictions

# CORS: comma-separated allowed origins (empty = same-origin only)
CORS_ORIGINS=

# Artifact locations (defaults point at the validated project artifacts)
MODELS_DIR=../models
MODEL_VERSION=1.0.0
RISK_CONFIG_VERSION=1.0.0
# PREDICT_THRESHOLD=   # leave unset: uses validated threshold 0.55 from model_metadata.json

# Limits
MAX_JSON_BYTES=1000000
MAX_CSV_BYTES=5000000
MAX_BATCH_ROWS=2000
TOP_K_FACTORS=10
